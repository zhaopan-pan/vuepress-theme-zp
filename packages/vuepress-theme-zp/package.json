{
  "name": "vuepress-theme-zp",
  "version": "1.0.60",
  "description": "custom theme of vuepress2.x",
  "keywords": [
    "vuepress-theme-zp",
    "vuepress-theme",
    "vuepress",
    "theme",
    "markdown",
    "vue",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/zhaopan-pan/vuepress-theme-zp",
  "bugs": {
    "url": "https://github.com/zhaopan-pan/vuepress-theme-zp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaopan-pan/vuepress-theme-zp.git"
  },
  "license": "MIT",
  "author": "zp",
  "type": "module",
  "exports": {
    ".": "./lib/node/index.js",
    "./client": "./lib/client/index.js",
    "./components/*": "./lib/client/components/*",
    "./layouts/*": "./lib/client/layouts/*",
    "./styles/*": "./lib/client/styles/*",
    "./templates/*": "./templates/*",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "main": "./lib/node/index.js",
  "types": "./lib/node/index.d.ts",
  "files": [
    "lib",
    "templates"
  ],
  "scripts": {
    "build": "rimraf ./templates/.temp && tsc --build tsconfig.build.json",
    "build:watch": "tsc --build -w tsconfig.build.json",
    "clean": "rimraf lib *.tsbuildinfo",
    "copy": "cpx \"src/**/*.{d.ts,vue,scss}\" lib"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@vuepress-zp/plugin-code-copy": "workspace:*",
    "@vuepress-zp/plugin-toc": "workspace:*",
    "@vuepress/client": "2.0.0-rc.23",
    "@vuepress/core": "2.0.0-rc.23",
    "@vuepress/helper": "2.0.0-rc.108",
    "@vuepress/plugin-active-header-links": "2.0.0-rc.107",
    "@vuepress/plugin-back-to-top": "2.0.0-rc.108",
    "@vuepress/plugin-container": "2.0.0-rc.28",
    "@vuepress/plugin-docsearch": "2.0.0-rc.108",
    "@vuepress/plugin-git": "2.0.0-rc.107",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.108",
    "@vuepress/plugin-nprogress": "2.0.0-rc.108",
    "@vuepress/plugin-palette": "2.0.0-rc.108",
    "@vuepress/plugin-prismjs": "2.0.0-rc.108",
    "@vuepress/plugin-pwa": "2.0.0-rc.108",
    "@vuepress/plugin-pwa-popup": "2.0.0-rc.12",
    "@vuepress/plugin-theme-data": "2.0.0-rc.107",
    "@vuepress/shared": "2.0.0-rc.23",
    "@vuepress/utils": "2.0.0-rc.23",
    "@vueuse/core": "^13.3.0",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vuepress-plugin-blog2": "2.0.0-rc.20",
    "vuepress-plugin-comment2": "2.0.0-rc.30"
  },
  "peerDependencies": {
    "sass-loader": "^13.3.1"
  },
  "peerDependenciesMeta": {
    "sass-loader": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vuepress/plugin-blog": "2.0.0-rc.108",
    "@vuepress/plugin-comment": "2.0.0-rc.108"
  }
}