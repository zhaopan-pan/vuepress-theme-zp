{
  "extends": "tsconfig-vuepress/base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "target": "ES2020",
    "paths": {
      "@theme-zp-client/*": ["./packages/vuepress-theme-zp/src/client/*"],
      "@theme-zp-src/*": ["./packages/vuepress-theme-zp/src/*"],
      "@vuepress-zp/*": ["./packages/@vuepress-zp/*"]
    }
  }
}
